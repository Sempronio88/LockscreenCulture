<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#14110F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Palabra del día"
            android:textColor="#E0C88C"
            android:textSize="22sp"
            android:layout_marginBottom="28dp"
            android:fontFamily="serif"/>

        <TextView
            android:id="@+id/txtActual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#E0C88C"
            android:textSize="34sp"
            android:textStyle="bold"
            android:fontFamily="serif"/>

        <TextView
            android:id="@+id/txtDefinicion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#D2C6B2"
            android:textSize="15sp"
            android:gravity="center"
            android:fontFamily="serif"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="36dp"/>

        <Button
            android:id="@+id/btnAplicarAhora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aplicar en pantalla de bloqueo"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnSiguiente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Siguiente palabra"
            android:layout_marginBottom="28dp"/>

        <Button
            android:id="@+id/btnCategorias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gestionar categorías"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnPalabras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gestionar palabras"/>

    </LinearLayout>
</ScrollView>
